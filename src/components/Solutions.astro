---
import Icon from './Icon.astro';
const backgrounds: Record<string, { image: string; zoom: number }> = {
  telefonia: { image: 'solutions/telefonia.webp', zoom: 2.18 },
  atencion: { image: 'solutions/call-center.webp', zoom: 1.91 },
  perifoneo: { image: 'solutions/perifonia.webp', zoom: 2.45 },
  video: { image: 'solutions/conferencia.webp', zoom: 1.91 },
};
import { solutions } from '../data/content';
---

<section id="soluciones" class="section container">
  <div class="section-heading">
    <div>
      <p class="section-kicker">Soluciones que trabajan contigo</p>
      <h2>
        Todo empieza con
        <br />
        una buena conexión.
      </h2>
    </div>
    <p>
      Desde una llamada hasta una reunión entre sedes. Encuentra la tecnología que se adapta a la
      forma de trabajar de tu empresa.
    </p>
  </div>
  <div class="solutions-grid">
    {solutions.map((s) => (
      <div class="solution-reveal" data-reveal>
        <a
          class="solution-card solution-interactive"
          href={s.localHref}
          aria-labelledby={`solution-card-${s.id}`}
        >
          <div class="solution-background" aria-hidden="true">
            <img
              src={'/images/' + backgrounds[s.id].image}
              style={`--image-zoom: ${backgrounds[s.id].zoom}`}
              alt=""
              width="920"
              height="1160"
              loading="lazy"
              decoding="async"
            />
          </div>
          <svg class="selection-orbit" aria-hidden="true">
            <rect x="1" y="1" rx="15" pathLength="100" />
          </svg>
          <span class="solution-icon">
            <Icon name={s.icon} size={28} />
          </span>
          <h3 id={`solution-card-${s.id}`}>{s.title}</h3>
          <p>{s.description}</p>
          <ul class="solution-tags">
            {s.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          <span class="solution-link">
            {s.label}
            <Icon size={19} />
          </span>
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .solutions-grid {
    gap: 18px;
    isolation: isolate;
  }
  .solution-reveal {
    position: relative;
    min-width: 0;
    display: flex;
    z-index: 0;
  }
  .solution-reveal:has(:hover, :focus-within) {
    z-index: 3;
  }
  .solution-interactive,
  .solution-interactive:first-child,
  .solution-interactive:last-child {
    position: relative;
    isolation: isolate;
    border: 1px solid #e0e0e0;
    border-radius: 16px;
    padding: 28px 23px !important;
    min-height: 385px;
    width: 100%;
    background: #fafafa;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  .solution-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    z-index: -1;
    pointer-events: none;
  }
  .solution-background img {
    /* Frame only the central photograph; the supplied files include white top/bottom margins. */
    position: absolute;
    left: 0;
    top: calc((1 - var(--image-zoom)) * 50%);
    width: 100%;
    height: calc(100% * var(--image-zoom));
    object-fit: cover;
    /* Transparency: 75% at rest; 25% when the card is selected. */
    opacity: 0.25;
    transition:
      opacity 0.3s,
      transform 0.5s;
  }
  .solution-interactive .solution-icon {
    background: #fff9;
    border: 1px solid #fff;
    backdrop-filter: blur(4px);
  }
  .solution-interactive .solution-tags {
    position: relative;
  }
  .solution-interactive .solution-tags li {
    background: #ffffffbf;
    border: 1px solid #e2e2e2;
  }
  .solution-interactive h3 {
    font-size: 22px;
  }
  .solution-interactive > p {
    color: #454545;
  }
  .solution-interactive .solution-link {
    gap: 8px;
  }
  .selection-orbit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .selection-orbit rect {
    width: calc(100% - 2px);
    height: calc(100% - 2px);
    fill: none;
    stroke: var(--brand);
    stroke-width: 1.6;
    stroke-dasharray: 26 74;
    opacity: 0;
  }
  .solution-interactive h3,
  .solution-interactive > p,
  .solution-interactive .solution-link {
    background: #fffffff0;
    border-radius: 6px;
    padding: 4px 6px;
    margin-left: -6px;
  }
  .solution-interactive h3,
  .solution-interactive .solution-link {
    width: fit-content;
  }
  .solution-interactive:focus-within .solution-background img,
  .solution-interactive:active .solution-background img {
    opacity: 0.75;
  }
  .solution-interactive:focus-within {
    border-color: #bb8585;
    box-shadow: 0 15px 40px #17171712;
    transform: translateY(-7px);
    z-index: 3;
  }
  .solution-interactive:focus-within .selection-orbit rect {
    animation: selection-circuit 0.85s ease-out 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .solution-interactive:hover {
      transform: translateY(-8px) scale(1.015);
      border-color: #c8a6a6;
      box-shadow: 0 18px 45px #17171716;
      z-index: 3;
    }
    .solution-interactive:hover .solution-background img {
      opacity: 0.75;
      transform: scale(1.035);
    }
    .solution-interactive:hover .selection-orbit rect {
      animation: selection-circuit 0.85s ease-out 1;
    }
  }
  @keyframes selection-circuit {
    0% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }
  @media (max-width: 1100px) {
    .solution-interactive,
    .solution-interactive:first-child,
    .solution-interactive:last-child {
      padding: 24px 18px !important;
    }
    .solution-interactive h3 {
      font-size: 20px;
    }
  }
  @media (max-width: 900px) {
    .solutions-grid {
      gap: 20px;
    }
    .solution-interactive,
    .solution-interactive:first-child,
    .solution-interactive:last-child {
      padding: 28px !important;
      min-height: 340px;
    }
    .solution-interactive h3 {
      font-size: 24px;
    }
  }
  @media (max-width: 600px) {
    .solution-interactive,
    .solution-interactive:first-child,
    .solution-interactive:last-child {
      min-height: 330px;
      padding: 27px !important;
    }
    .solution-interactive h3 {
      font-size: 25px;
    }
    .solution-background img {
      object-position: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .solution-interactive,
    .solution-interactive:hover,
    .solution-interactive:focus-within {
      transform: none;
      transition: none;
    }
    .solution-interactive .selection-orbit rect {
      animation: none !important;
    }
    .solution-background img {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
