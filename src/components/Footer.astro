---
import { solutions, origin } from '../data/content';
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a href="/#inicio" aria-label="OmniMedia Perú, volver al inicio">
        <img src="/images/logo.webp" width="166" height="59" alt="OmniMedia Perú" loading="lazy" />
      </a>
      <p>
        Conectamos personas.
        <br />
        Integramos soluciones.
      </p>
    </div>
    <div>
      <h3>Soluciones</h3>
      {solutions.map((s) => (
        <a href={s.localHref}>{s.title}</a>
      ))}
    </div>
    <div>
      <h3>Explora</h3>
      <a href="/productos/">Catálogo de equipos</a>
      <a href={origin + '/telefonia/'}>Telefonía</a>
      <a href="/servicios/">Servicios y soporte</a>
      <a href="/conocenos/">Nuestra empresa</a>
    </div>
    <div>
      <h3>Conversemos</h3>
      <a href="/#cotizar">Preparar una cotización</a>
      <a href="/contactenos/">Contacto comercial</a>
      <a href="tel:+5117152145">01 715 2145</a>
      <a href="tel:+51916945556">916 945 556</a>
      <span>Lima, Perú</span>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} OmniMedia Perú.</span>
    <span>Propuesta de diseño · Vista preliminar</span>
    <a href="/#inicio">Volver al inicio ↑</a>
  </div>
</footer>
