---
import Icon from './Icon.astro';
import BrandCarousel from './BrandCarousel.astro';
import VoiceVisual from './VoiceVisual.astro';
import { campaigns } from '../data/campaigns';
---

<section class="commercial-hero" id="inicio" aria-labelledby="hero-title">
  <div class="container">
    <div class="banner-heading">
      <p>Telecomunicaciones para empresas</p>
      <h1 id="hero-title" tabindex="-1">
        Tu empresa, mejor conectada.
      </h1>
      <span>Telefonía IP, videoconferencia y soluciones que acercan a las personas.</span>
    </div>
    <div
      class="campaign-stage"
      role="region"
      aria-label="Soluciones y equipos destacados"
      aria-roledescription="carrusel"
      tabindex="0"
    >
      {campaigns.map((campaign, index) => (
        <article
          class:list={['campaign', { 'is-active': index === 0 }]}
          id={`campaign-${campaign.id}`}
          aria-labelledby={`title-${campaign.id}`}
          data-campaign
          role="group"
          aria-roledescription="diapositiva"
        >
          <div class="campaign-copy">
            <div class="campaign-tags">
              {campaign.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <h2 id={`title-${campaign.id}`}>{campaign.title}</h2>
            <p>{campaign.description}</p>
            <div class="campaign-actions">
              <a class="button" href={campaign.href} target="_blank" rel="noopener noreferrer">
                {campaign.action}
                <Icon size={18} />
              </a>
              <a class="text-link" href={campaign.category}>
                Conocer más
                <Icon size={16} />
              </a>
            </div>
          </div>
          <div
            class:list={[
              'campaign-visual',
              {
                'campaign-voice': campaign.id === 'audios',
                'campaign-video': campaign.id === 'video',
              },
            ]}
          >
            {campaign.id === 'audios' ? (
              <VoiceVisual />
            ) : (
              <img
                src={`/images/${campaign.image}`}
                width={campaign.id === 'video' ? 1672 : 2172}
                height={campaign.id === 'video' ? 941 : 724}
                alt={campaign.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
                draggable="false"
              />
            )}
            <div class="campaign-caption">
              <Icon name={campaign.icon} size={20} />
              <span>{campaign.note}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="campaign-toolbar" hidden>
      <div class="campaign-selector" role="group" aria-label="Elegir solución destacada">
        {campaigns.map((campaign, index) => (
          <button
            type="button"
            data-campaign-select={index}
            aria-controls={`campaign-${campaign.id}`}
            aria-pressed={index === 0}
          >
            {campaign.label}
          </button>
        ))}
      </div>
      <div class="campaign-pagination">
        <button type="button" class="campaign-playback" data-campaign-playback aria-pressed="false">
          <span data-campaign-playback-label>Pausar</span>
        </button>
        <span data-campaign-position aria-live="off" aria-atomic="true">
          01 / {String(campaigns.length).padStart(2, '0')}
        </span>
        <button type="button" data-campaign-prev aria-label="Vista anterior">
          <Icon size={18} />
        </button>
        <button type="button" data-campaign-next aria-label="Vista siguiente">
          <Icon size={18} />
        </button>
      </div>
    </div>
    <noscript>
      <style>
        .campaign {
          visibility: visible !important;
          opacity: 1 !important;
          pointer-events: auto !important;
          grid-area: auto !important;
          transform: none !important;
          margin-bottom: 40px;
        }
      </style>
    </noscript>
  </div>
</section>
<BrandCarousel />
