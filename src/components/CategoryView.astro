---
import type { CategoryPage } from '../data/category';
import Icon from './Icon.astro';
interface Props {
  entry: CategoryPage;
  related: CategoryPage[];
  section: { label: string; href: string };
  exploreLabel: string;
  relatedLabel: string;
}
const { entry, related, section, exploreLabel, relatedLabel } = Astro.props;
---

<section class="solution-hero" id="inicio" aria-labelledby="hero-title">
  <div class="container">
    <nav class="solution-breadcrumb" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href={section.href}>{section.label}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{entry.title}</span>
    </nav>
    <div class="solution-hero-grid">
      <div class="solution-hero-copy">
        <p class="solution-category">
          <Icon name={entry.icon} size={18} />
          {entry.title}
        </p>
        <h1 id="hero-title" tabindex="-1">
          {entry.headline}
        </h1>
        <p class="solution-lead">{entry.description}</p>
        <div class="solution-hero-actions">
          <a class="button" href="#explorar">
            {exploreLabel}
            <Icon size={18} />
          </a>
          <a class="text-link" href="/#cotizar">
            Solicitar asesoría
            <Icon size={18} />
          </a>
        </div>
      </div>
      <figure class="solution-hero-visual">
        <img
          src={`/images/${entry.image}`}
          width="674"
          height="580"
          alt={entry.imageAlt}
          fetchpriority="high"
        />
        <figcaption>
          <Icon name={entry.icon} size={18} />
          <span>{entry.imageNote}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
<section class="container solution-overview" aria-labelledby="solution-intro-title">
  <div data-reveal>
    <h2 id="solution-intro-title">{entry.introTitle}</h2>
  </div>
  <div class="solution-overview-copy" data-reveal>
    {entry.introduction.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
</section>
<section
  class="container solution-principles"
  aria-label={`Claves de ${entry.title.toLowerCase()}`}
>
  {entry.points.map(([title, text]) => (
    <div data-reveal>
      <h3>{title}</h3>
      <p>{text}</p>
    </div>
  ))}
</section>
<section class="solution-explore" id="explorar" aria-labelledby="explore-title">
  <div class="container solution-explore-grid">
    <div class="solution-explore-intro" data-reveal>
      <p class="section-kicker">Conoce las opciones</p>
      <h2 id="explore-title">{entry.linksTitle}</h2>
      <p>Encuentra información de cada categoría y cuéntanos qué necesita tu empresa.</p>
    </div>
    <ul class="solution-large-links">
      {entry.links.map((link) => (
        <li data-reveal>
          <a class="solution-large-link" href={link.href}>
            <span>
              <strong>{link.title}</strong>
              <small>{link.description}</small>
            </span>
            <span class="large-link-arrow" aria-label="Visitar sitio de la categoría">
              ↗
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<section class="container solution-conversation" aria-labelledby="conversation-title">
  <div data-reveal>
    <p class="section-kicker">Hablemos de tu proyecto</p>
    <h2 id="conversation-title">Empecemos por lo que necesitas.</h2>
  </div>
  <div data-reveal>
    <p>
      Cuéntanos cómo trabaja tu equipo y qué quieres mejorar. Te ayudamos a orientar la evaluación
      de tu solución.
    </p>
    <a class="button" href="/#cotizar">
      Solicitar cotización
      <Icon size={18} />
    </a>
  </div>
</section>
<nav class="container solution-related" aria-label={relatedLabel}>
  <p>También puedes explorar</p>
  <div>
    {related.map((item) => (
      <a href={item.path}>
        <Icon name={item.icon} size={20} />
        <span>{item.title}</span>
        <Icon size={18} />
      </a>
    ))}
  </div>
</nav>
