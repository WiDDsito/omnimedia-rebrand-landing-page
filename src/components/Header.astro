---
import Icon from './Icon.astro';
import NavigationTree from './NavigationTree.astro';
import { navigation } from '../data/navigation';
---

<a class="skip-link" href="#contenido">
  Saltar al contenido
</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand-logo" href="#inicio" aria-label="OmniMedia Perú, inicio">
      <img src="/images/logo.png" width="180" height="64" alt="OmniMedia Perú" />
    </a>
    <button
      class="menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span>Menú</span>
      <Icon name="menu" size={20} />
    </button>
    <nav id="main-navigation" aria-label="Navegación principal">
      {navigation.map((item) =>
        item.children.length ? (
          <details class="nav-dropdown">
            <summary aria-controls={`panel-${item.id}`}>
              {item.label}
              <Icon name="chevron" size={14} />
            </summary>
            <div class="mega-panel" id={`panel-${item.id}`}>
              <div class="container mega-layout">
                <div class="mega-intro">
                  <p>{item.intro}</p>
                  <span>{item.description}</span>
                  <a href={item.url}>
                    Explorar {item.label.toLowerCase()}
                    <Icon size={16} />
                  </a>
                  <a class="mega-contact" href="#cotizar">
                    Hablemos de tu proyecto
                  </a>
                </div>
                <div class:list={['mega-families', { 'mega-services': item.id === 'services' }]}>
                  {item.children.map((family) => (
                    <section class="nav-family" aria-labelledby={`${item.id}-${family.id}`}>
                      <a class="family-title" href={family.url} id={`${item.id}-${family.id}`}>
                        <Icon name={family.icon} size={20} />
                        <span>{family.label}</span>
                        <span class="family-arrow" aria-hidden="true">
                          ↗
                        </span>
                      </a>
                      <p>{family.description}</p>
                      <NavigationTree items={family.children} context={family.label} />
                    </section>
                  ))}
                </div>
              </div>
            </div>
          </details>
        ) : (
          <a class="nav-direct" href={item.url}>
            {item.label}
          </a>
        ),
      )}
      <div class="mobile-nav-contact">
        <a href="tel:+5117152145">01 715 2145</a>
        <a href="tel:+51916945556">916 945 556</a>
        <a href="mailto:cotizaciones@omnimediaperu.com">cotizaciones@omnimediaperu.com</a>
      </div>
    </nav>
    <a class="button button-small header-cta" href="#cotizar" aria-label="Solicitar cotización">
      <span class="cta-full">Solicitar cotización</span>
      <span class="cta-short" aria-hidden="true">
        Cotizar
      </span>
      <Icon size={16} />
    </a>
  </div>
</header>
<div class="navigation-backdrop" aria-hidden="true"></div>
