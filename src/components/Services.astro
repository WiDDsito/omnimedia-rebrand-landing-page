---
import Icon from './Icon.astro';
import { origin } from '../data/content';
const steps = [
  ['Entendemos tu operación', 'Conversamos sobre tus necesidades, equipos actuales y objetivos.'],
  ['Definimos tu solución', 'Evaluamos alternativas y detallamos el alcance de la propuesta.'],
  ['Conectamos tu equipo', 'Planificamos la instalación y configuración de la solución acordada.'],
  ['Te acompañamos', 'Definimos las condiciones de soporte para tu implementación.'],
];
---

<section class="section container services enhanced-services" id="servicios">
  <div class="services-intro">
    <p class="section-kicker">Tecnología con acompañamiento</p>
    <h2>
      Un equipo contigo.
      <br />
      De principio a fin.
    </h2>
    <p>
      Elegir tecnología es solo el comienzo. Te ayudamos a integrar una solución que tenga sentido
      para tu empresa.
    </p>
    <a class="text-link" href={origin + '/servicios/soporte-tecnico/'}>
      Conocer nuestros servicios <Icon size={18} />
    </a>
    <div class="services-detail">
      <Icon name="phone" size={22} />
      <p>
        También damos voz a tu central.
        <br />
        <a href={origin + '/telefonia/audios-para-centrales-telefonicas/'}>
          Descubre nuestros audios e IVR
        </a>
      </p>
    </div>
  </div>
  <ol class="process-bento">
    {steps.map(([title, description], i) => (
      <li data-reveal>
        <div class="bento-top">
          <span class="step-number">0{i + 1}</span>
          <span class="bento-icon">
            <Icon name={['chat', 'grid', 'globe', 'phone'][i]} size={26} />
          </span>
        </div>
        <div>
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
<section class="about-section" id="nosotros">
  <div class="container about-grid">
    <div>
      <p class="section-kicker">Somos OmniMedia Perú</p>
      <h2>
        La experiencia de conectar.
        <br />
        La cercanía de acompañar.
      </h2>
    </div>
    <div>
      <p>
        Somos una empresa integradora especializada en telefonía y telecomunicaciones. Acompañamos a
        organizaciones en la elección e implementación de sus comunicaciones empresariales.
      </p>
      <a class="text-link" href={origin + '/conocenos/'}>
        Conoce nuestra empresa <Icon size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .enhanced-services {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: 70px;
    align-items: center;
  }
  .process-bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .process-bento li {
    grid-column: span 5;
    position: relative;
    padding: 26px;
    min-height: 225px;
    border-radius: 16px;
    border: 1px solid #e4e4e4;
    background: #f7f7f7;
    display: flex;
    flex-direction: column;
    gap: 25px;
    overflow: hidden;
  }
  .process-bento li:first-child,
  .process-bento li:last-child {
    grid-column: span 7;
  }
  .process-bento li:first-child {
    background: #f4eeee;
    border-color: #e9dddd;
  }
  .process-bento li:last-child {
    background: #232323;
    border-color: #232323;
    color: white;
  }
  .bento-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .process-bento .step-number {
    width: 34px;
    height: 34px;
    font-size: 12px;
    background: transparent;
    border-color: #cfc7c7;
  }
  .bento-icon {
    color: #8c7777;
  }
  .process-bento li:last-child .step-number {
    color: #f2b6b6;
    border-color: #665454;
  }
  .process-bento li:last-child .bento-icon {
    color: #dab9b9;
  }
  .process-bento h3 {
    font-size: 20px;
    letter-spacing: -0.3px;
    line-height: 1.2;
    margin-bottom: 11px;
  }
  .process-bento p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
  }
  .process-bento li:last-child p {
    color: #ccc;
  }
  @media (max-width: 1100px) {
    .enhanced-services {
      gap: 40px;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
    .process-bento li {
      padding: 22px 18px;
    }
    .process-bento h3 {
      font-size: 18px;
    }
  }
  @media (max-width: 900px) {
    .enhanced-services {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .process-bento {
      max-width: 700px;
    }
    .process-bento li {
      padding: 27px;
      min-height: 210px;
    }
    .process-bento h3 {
      font-size: 22px;
    }
    .process-bento p {
      font-size: 14px;
    }
    .services-intro {
      max-width: 600px;
    }
  }
  @media (max-width: 540px) {
    .process-bento {
      gap: 12px;
      grid-template-columns: 1fr;
    }
    .process-bento li,
    .process-bento li:first-child,
    .process-bento li:last-child {
      grid-column: auto;
      min-height: 195px;
      padding: 24px;
      gap: 22px;
    }
    .process-bento h3 {
      font-size: 22px;
    }
  }
</style>
