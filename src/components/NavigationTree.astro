---
import Icon from './Icon.astro';
import { localTelephonyHref } from '../data/telephony-pages.mjs';
import type { NavigationItem } from '../data/navigation';
interface Props {
  items: NavigationItem[];
  context?: string;
}
const { items, context = '' } = Astro.props;
---

<ul class="navigation-tree">
  {items.map((item) => (
    <li>
      {item.children.length ? (
        <details class="navigation-branch">
          <summary>
            <span>{item.label}</span>
            <Icon name="plus" size={14} />
          </summary>
          <div class="branch-content">
            <a class="branch-overview" href={localTelephonyHref(item.url)}>
              Ver {item.label} <span aria-hidden="true">↗</span>
            </a>
            <Astro.self items={item.children} context={item.label} />
          </div>
        </details>
      ) : (
        <a
          href={localTelephonyHref(item.url)}
          aria-label={context ? `${context}: ${item.label}` : undefined}
        >
          {item.label}
          {localTelephonyHref(item.url).startsWith('https://www.lineassiptrunk.com') && (
            <span aria-label="Sitio externo"> ↗</span>
          )}
        </a>
      )}
    </li>
  ))}
</ul>
