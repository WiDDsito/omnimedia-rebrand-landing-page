---
import Icon from './Icon.astro';
import { equipment } from '../data/content';
import { productPaths } from '../data/product-pages.mjs';
---

<section class="equipment-section" id="equipos">
  <div class="container section">
    <div class="section-heading compact">
      <div>
        <p class="section-kicker">El equipo hace la diferencia</p>
        <h2>
          Tecnología para
          <br />
          cada espacio de trabajo.
        </h2>
      </div>
      <a class="text-link" href="/productos/">
        Explorar catálogo <Icon size={19} />
      </a>
    </div>
    <div class="equipment-grid">
      {equipment.map((e) => (
        <a class="equipment-card" href={productPaths[e.id]}>
          <div class="equipment-image">
            <div class="equipment-artwork">
              <img
                src={
                  '/images/' + (e.id === 'phones' ? 'omnimedia-telefonos-tarjeta.webp' : e.image)
                }
                alt={e.title + ' del portafolio de OmniMedia Perú'}
                width={e.id === 'phones' ? 1352 : 674}
                height={e.id === 'phones' ? 1163 : 580}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <div class="equipment-title">
            <h3>{e.title}</h3>
            <Icon size={20} />
          </div>
          <p>{e.desc}</p>
        </a>
      ))}
    </div>
    <div class="equipment-more">
      <span>¿Buscas algo más específico?</span>
      <a href={productPaths.hotels}>Telefonía hotelera</a>
      <a href="/telefonia/centrales-telefonicas/">Centrales telefónicas</a>
      <a href={productPaths.refurbished}>Equipos remanufacturados</a>
    </div>
  </div>
</section>

<style>
  .equipment-artwork {
    width: 100%;
    height: 100%;
  }
</style>
