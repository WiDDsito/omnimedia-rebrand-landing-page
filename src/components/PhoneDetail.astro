---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { phoneBrands, phones, phoneCatalogPath } from '../data/phone-catalog.mjs';
import '../styles/solution-pages.css';
import '../styles/phone-catalog.css';
interface Props {
  phone: (typeof phones)[number];
}
const { phone } = Astro.props;
const brand = phoneBrands.find((item) => item.id === phone.brand)!;
const related = phones
  .filter((item) => item.brand === phone.brand && item.id !== phone.id)
  .slice(0, 3);
const whatsapp = `https://api.whatsapp.com/send?phone=51916945556&text=${encodeURIComponent(`Hola, deseo información sobre ${phone.title}.`)}`;
---

<BaseLayout title={`${phone.title} | OmniMedia Perú`} description={phone.description}>
  <Header />
  <main id="contenido">
    <section class="solution-hero" id="inicio" aria-labelledby="hero-title">
      <div class="container">
        <nav class="solution-breadcrumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href={phoneCatalogPath}>Teléfonos</a>
          <span aria-hidden="true">/</span>
          <a href={brand.path}>{brand.title}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{phone.model}</span>
        </nav>
        <div class="solution-hero-grid">
          <div class="solution-hero-copy">
            <p class="solution-category">
              <Icon name="phone" />
              Teléfonos {brand.title}
            </p>
            <h1 id="hero-title" tabindex="-1">
              {phone.model}
            </h1>
            <p class="solution-lead">{phone.description}</p>
            <div class="solution-hero-actions">
              <a class="button" href="#caracteristicas">
                Ver características <Icon size={18} />
              </a>
              <a class="text-link" href="/contactenos/">
                Solicitar asesoría <Icon size={18} />
              </a>
            </div>
          </div>
          <figure class="solution-hero-visual">
            <img
              src={`/images/${phone.image}`}
              width="640"
              height="560"
              alt={phone.title}
              fetchpriority="high"
            />
            <figcaption>
              <Icon name="phone" size={18} />
              <span>
                {phone.imageIsReference
                  ? 'Imagen referencial de telefonía empresarial.'
                  : `${phone.title}. Imagen del catálogo original.`}
              </span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section
      class="container phone-specifications"
      id="caracteristicas"
      aria-labelledby="specifications-title"
    >
      <div data-reveal>
        <p class="section-kicker">Conoce el equipo</p>
        <h2 id="specifications-title">Características publicadas.</h2>
        <p>
          Información del catálogo de OmniMedia. Consulta la documentación y confirma la revisión y
          configuración del equipo al cotizar.
        </p>
        {phone.sharedFeatures && (
          <p class="phone-source-note">
            La fuente agrupa {phone.variantGroup?.join(', ')}. Estas características corresponden a
            la familia; las prestaciones específicas pueden variar entre modelos.
          </p>
        )}
        {phone.sourceNote && <p class="phone-source-note">{phone.sourceNote}</p>}
      </div>
      <ul class="phone-feature-list">
        {phone.features.map((feature) => (
          <li data-reveal>
            <Icon name="check" size={18} />
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="phone-documentation" aria-labelledby="documentation-title">
      <div class="container">
        <div data-reveal>
          <p class="section-kicker">Información para tu proyecto</p>
          <h2 id="documentation-title">Documentación y asesoría.</h2>
        </div>
        <ul class="solution-large-links">
          {phone.pdfs.map((href, index) => (
            <li data-reveal>
              <a class="solution-large-link" href={href}>
                <span>
                  <strong>Ficha técnica{phone.pdfs.length > 1 ? ` ${index + 1}` : ''} (PDF)</strong>
                  <small>Documento enlazado desde la fuente original.</small>
                </span>
                <Icon size={24} />
              </a>
            </li>
          ))}
          <li data-reveal>
            <a class="solution-large-link" href={phone.source}>
              <span>
                <strong>Ver referencia original</strong>
                <small>Consulta la ficha de OmniMedia de la que procede la información.</small>
              </span>
              <Icon size={24} />
            </a>
          </li>
          <li data-reveal>
            <a
              class="solution-large-link"
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Consultar ${phone.title} por WhatsApp (se abre en otra pestaña)`}
            >
              <span>
                <strong>Consultar por WhatsApp</strong>
                <small>Solicita información sobre este modelo.</small>
              </span>
              <Icon name="chat" size={24} />
            </a>
          </li>
        </ul>
      </div>
    </section>
    <nav class="container solution-related" aria-label="Otros teléfonos de la marca">
      <p>También puedes explorar</p>
      <div>
        {related.map((item) => (
          <a href={item.path}>
            <Icon name="phone" size={20} />
            <span>{item.model}</span>
            <Icon size={18} />
          </a>
        ))}
      </div>
      <a class="text-link" href={brand.path}>
        Ver todos los teléfonos {brand.title} <Icon size={18} />
      </a>
    </nav>
  </main>
  <Footer />
</BaseLayout>
