---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { servicePages } from '../../data/service-pages.mjs';
import '../../styles/solution-pages.css';
import '../../styles/service-catalog.css';
---

<BaseLayout
  title="Servicios para empresas | OmniMedia Perú"
  description="Conoce el soporte técnico y los audios e IVR para las comunicaciones de tu empresa."
>
  <Header />
  <main id="contenido">
    <section class="solution-hero" id="inicio" aria-labelledby="hero-title">
      <div class="container">
        <nav class="solution-breadcrumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Servicios</span>
        </nav>
        <div class="solution-hero-grid">
          <div class="solution-hero-copy">
            <p class="solution-category">
              <Icon name="grid" size={28} /> Servicios
            </p>
            <h1 id="hero-title" tabindex="-1">
              Un equipo contigo, en cada conexión.
            </h1>
            <p class="solution-lead">
              Soporte para tu instalación y mensajes para tu atención telefónica. Conversemos sobre
              lo que necesita tu empresa.
            </p>
            <div class="solution-hero-actions">
              <a class="button" href="#servicios-disponibles">
                Explorar servicios <Icon size={18} />
              </a>
              <a class="text-link" href="/#cotizar">
                Solicitar asesoría <Icon size={18} />
              </a>
            </div>
          </div>
          <figure class="solution-hero-visual">
            <img
              src="/images/central.webp"
              width="674"
              height="580"
              alt="Imagen referencial de centrales telefónicas empresariales"
              fetchpriority="high"
            />
            <figcaption>
              <Icon name="phone" size={18} />
              <span>Acompañamiento para tus comunicaciones.</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section
      class="container service-catalog"
      id="servicios-disponibles"
      aria-labelledby="families-title"
    >
      <div class="section-heading compact" data-reveal>
        <div>
          <p class="section-kicker">Conoce nuestros servicios</p>
          <h2 id="families-title">El siguiente paso para tu instalación.</h2>
        </div>
        <p>
          Consulta el alcance de cada servicio y comparte tu requerimiento. La modalidad de atención
          se acuerda en cada propuesta.
        </p>
      </div>
      <div class="service-catalog-grid">
        {servicePages.map((service) => (
          <a class="equipment-card" href={service.path} data-reveal>
            <div class="equipment-image">
              <img
                src={`/images/${service.image}`}
                alt={service.imageAlt}
                width="674"
                height="580"
                loading="lazy"
              />
            </div>
            <div class="equipment-title">
              <h3>{service.title}</h3>
              <Icon size={20} />
            </div>
            <p>{service.description}</p>
          </a>
        ))}
      </div>
    </section>
    <section class="container solution-conversation" aria-labelledby="conversation-title">
      <div data-reveal>
        <p class="section-kicker">Hablemos de tu proyecto</p>
        <h2 id="conversation-title">Empecemos por tu requerimiento.</h2>
      </div>
      <div data-reveal>
        <p>
          Cuéntanos qué necesitas revisar o qué mensajes quieres preparar. Te ayudamos a orientar la
          evaluación del servicio.
        </p>
        <a class="button" href="/#cotizar">
          Solicitar cotización <Icon size={18} />
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
