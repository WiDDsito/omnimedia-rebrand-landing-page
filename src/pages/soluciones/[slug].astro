---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CategoryView from '../../components/CategoryView.astro';
import { solutionPages } from '../../data/solution-pages.mjs';
import '../../styles/solution-pages.css';
export function getStaticPaths() {
  return solutionPages.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}
const { solution } = Astro.props;
---

<BaseLayout title={`${solution.title} | OmniMedia Perú`} description={solution.description}>
  <Header />
  <main id="contenido">
    <CategoryView
      entry={solution}
      related={solutionPages.filter((item) => item.id !== solution.id)}
      section={{ label: 'Soluciones', href: '/#soluciones' }}
      exploreLabel="Explorar la solución"
      relatedLabel="Otras soluciones"
    />
  </main>
  <Footer />
</BaseLayout>
