---
import PhoneCatalog from '../../components/PhoneCatalog.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CategoryView from '../../components/CategoryView.astro';
import { productPages } from '../../data/product-pages.mjs';
import '../../styles/solution-pages.css';
export function getStaticPaths() {
  return productPages.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product } = Astro.props;
---

{product.id === 'phones' ? (
  <PhoneCatalog />
) : (
  <BaseLayout title={`${product.title} | OmniMedia Perú`} description={product.description}>
    <Header />
    <main id="contenido">
      <CategoryView
        entry={product}
        related={productPages.filter((item) => item.id !== product.id)}
        section={{ label: 'Productos', href: '/productos/' }}
        exploreLabel="Explorar los equipos"
        relatedLabel="Otras familias de productos"
      />
    </main>
    <Footer />
  </BaseLayout>
)}
