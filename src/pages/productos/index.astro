---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { productPages } from '../../data/product-pages.mjs';
import '../../styles/solution-pages.css';
import '../../styles/product-catalog.css';
---

<BaseLayout
  title="Productos para empresas | OmniMedia Perú"
  description="Explora teléfonos, auriculares, equipos de videoconferencia, networking y accesorios para tu empresa."
>
  <Header />
  <main id="contenido">
    <section class="solution-hero" id="inicio" aria-labelledby="hero-title">
      <div class="container">
        <nav class="solution-breadcrumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Productos</span>
        </nav>
        <div class="solution-hero-grid">
          <div class="solution-hero-copy">
            <p class="solution-category">
              <Icon name="grid" size={28} /> Productos
            </p>
            <h1 id="hero-title" tabindex="-1">
              Equipos para cada forma de trabajar.
            </h1>
            <p class="solution-lead">
              Encuentra la familia que necesita tu empresa. Explora las opciones y conversemos sobre
              tu instalación.
            </p>
            <div class="solution-hero-actions">
              <a class="button" href="#familias">
                Explorar productos <Icon size={18} />
              </a>
              <a class="text-link" href="/#cotizar">
                Solicitar asesoría <Icon size={18} />
              </a>
            </div>
          </div>
          <figure class="solution-hero-visual">
            <img
              src="/images/phone.jpg"
              width="674"
              height="580"
              alt="Imagen referencial de equipos de telefonía del portafolio de OmniMedia Perú"
              fetchpriority="high"
            />
            <figcaption>
              <Icon name="phone" size={18} />
              <span>Tecnología para conectar personas y espacios.</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section class="container product-catalog" id="familias" aria-labelledby="families-title">
      <div class="section-heading compact" data-reveal>
        <div>
          <p class="section-kicker">Elige una familia</p>
          <h2 id="families-title">Tu próximo equipo empieza aquí.</h2>
        </div>
        <p>
          Información clara para orientar la elección. Los modelos y sus condiciones se revisan en
          cada propuesta.
        </p>
      </div>
      <div class="product-catalog-grid">
        {productPages.map((product) => (
          <a class="equipment-card" href={product.path} data-reveal>
            <div class="equipment-image">
              <img
                src={`/images/${product.image}`}
                alt={product.imageAlt}
                width="674"
                height="580"
                loading="lazy"
              />
            </div>
            <div class="equipment-title">
              <h3>{product.title}</h3>
              <Icon size={20} />
            </div>
            <p>{product.description}</p>
          </a>
        ))}
      </div>
    </section>
    <section class="container solution-conversation" aria-labelledby="conversation-title">
      <div data-reveal>
        <p class="section-kicker">Hablemos de tu proyecto</p>
        <h2 id="conversation-title">Cuéntanos qué necesitas conectar.</h2>
      </div>
      <div data-reveal>
        <p>
          Comparte la marca, el modelo o el uso que buscas. Te ayudamos a orientar la evaluación del
          equipo.
        </p>
        <a class="button" href="/#cotizar">
          Solicitar cotización <Icon size={18} />
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
