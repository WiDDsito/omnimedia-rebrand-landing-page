---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/typography.css';
import '../styles/banner.css';
import '../styles/interactions.css';
import BackToTop from '../components/BackToTop.astro';
import bodyFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    {[bodyFont, '/fonts/satoshi-900.woff2'].map((font) => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      http-equiv="Content-Security-Policy"
      content="form-action 'none'; base-uri 'self'; object-src 'none'"
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4f4f4" />
    <title>OmniMedia Perú | Vista preliminar</title>
    <meta
      name="description"
      content="Vista preliminar de OmniMedia Perú. Telefonía IP, videoconferencia y soluciones de comunicación para empresas."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <noscript>
      <style>
        .menu-toggle,
        .navigation-backdrop {
          display: none !important;
        }
        @media (max-width: 1100px) {
          .site-header nav {
            display: block !important;
            position: static !important;
            max-height: none !important;
          }
          .header-inner {
            height: auto !important;
            display: block !important;
            padding-block: 20px;
          }
          .site-header {
            position: relative !important;
          }
          .header-cta {
            margin-top: 12px;
          }
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
    <BackToTop />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
